---
import '../styles/global.css';
import {pageUrl,siteUrl,indexable} from '../lib/config';
import {release} from '../data/release';
// build.format 'file' renders /pricing as pricing.html; Pages serves it at /pricing (and 308s the .html form).
const cleanPath=Astro.url.pathname.replace(/\.html$/,'').replace(/\/index$/,'/')||'/';
const navigation=[{href:'/bids',label:'The Bid Desk',section:['/bids','/open-bids','/pricing','/becoming-a-contractor','/readiness','/contracts']},{href:'/restaurant-advisory',label:'The Restaurant Advisory',section:['/restaurant-advisory']},{href:'/about',label:'About',section:['/about']}];
const inSection=(paths:string[])=>paths.some(p=>cleanPath===p||cleanPath.startsWith(p+'/'));
const {title='Tidewater | The bid desk for DMV hospitality and service operators', description='Find relevant government contracts. Understand the price, paperwork and process. Tidewater helps hospitality and service operators prepare bids.', canonical=cleanPath, ogImage='/assets/og-default.png', schema=[]} = Astro.props;
const structured=[{'@context':'https://schema.org','@type':'Organization',name:'Tidewater',legalName:'Tidewater Advisory LLC',url:siteUrl,description:'Government bid support, restaurant funding intelligence, operational advisory and implementation management for service and hospitality operators.'},...(Array.isArray(schema)?schema:[schema])];
const safeJson = JSON.stringify(structured).replace(/</g,'\\u003c');
const analytics=import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#F5F5F0" />
  <meta name="tidewater-release" content={release.version} />
  <meta name="tidewater-commit" content={release.commit} />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  {(Astro.props.noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tidewater" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl(canonical)} />
  <meta property="og:image" content={pageUrl(ogImage)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={pageUrl(canonical)} />
  <link rel="preload" href="/assets/fonts/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={safeJson} />
  {analytics && <script defer data-domain={analytics} src="https://plausible.io/js/script.js"></script>}
  <title>{title}</title>
  <noscript><style>@media(max-width:970px){.primary-nav{display:block;position:static;box-shadow:none}.header-inner{flex-wrap:wrap}.primary-nav{order:3;width:100%}.menu-toggle,.theme-toggle{display:none}}</style></noscript>
  <script is:inline>
    try {const theme=localStorage.getItem('tidewater-theme');if(theme==='dark'||theme==='light')document.documentElement.dataset.theme=theme;}catch{}
  </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="container header-inner">
  <a class="logo" href="/">Tidewater<span class="logo-subtitle"> Advisory</span><span class="sr-only"> homepage</span></a>
  <nav class="primary-nav" id="primary-nav" aria-label="Main navigation"><ul class="nav-list">
    {navigation.map(item=><li><a href={item.href} aria-current={cleanPath===item.href?'page':inSection(item.section)?'true':undefined}>{item.label}</a></li>)}
    <li class="nav-contact"><a href="/contact" aria-current={cleanPath==='/contact'?'page':undefined}>Contact Tidewater</a></li>
  </ul></nav>
  <div class="header-actions"><button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch color theme" title="Switch color theme"><span aria-hidden="true">◐</span></button><a class="button header-cta" href="/contact">Contact Tidewater <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" id="menu-toggle">Menu <span aria-hidden="true">＋</span></button></div>
</div></header>
<main id="main"><slot /></main>
<footer class="footer"><div class="container">
  <div class="footer-layout"><div><a href="/" class="logo">Tidewater<span class="logo-subtitle">Advisory</span></a></div><nav class="footer-links" aria-label="Footer"><a href="/contact">Contact</a><a href="/open-bids">Open bids</a><a href="/pricing">Bid pricing</a><a href="/becoming-a-contractor">Becoming a contractor</a><a href="/restaurant-advisory/funding">Funding desk</a><a href="/restaurant-advisory/food-waste">Tidewater Food Waste</a><a href="/insights">Insights</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/sitemap.xml">Sitemap</a></nav></div>
  <p class="footer-small">Tidewater is a trade name of Tidewater Advisory LLC. Not affiliated with any government agency. We do not guarantee contract awards or grant funding.</p>
  <p class="footer-small">© {new Date().getFullYear()} Tidewater Advisory LLC · [[TODO: Publishable business mailing address]] · <a href="mailto:hello@tidewaterbid.com">hello@tidewaterbid.com</a></p>
  <p class="footer-small release-label">Website v{release.version} · <a href="/credits">Image &amp; typography credits</a></p>
</div></footer>
<script is:inline>
  const menu=document.getElementById('menu-toggle');const nav=document.getElementById('primary-nav');
  const setMenu=(open)=>{if(nav)nav.dataset.open=String(open);menu?.setAttribute('aria-expanded',String(open));};
  menu?.addEventListener('click',()=>setMenu(nav?.dataset.open!=='true'));
  document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&nav?.dataset.open==='true'){setMenu(false);menu?.focus();}});
  document.addEventListener('click',(event)=>{if(nav?.dataset.open==='true'&&!event.target.closest('.header-inner'))setMenu(false);});
  nav?.addEventListener('click',(event)=>{if(event.target.closest('a'))setMenu(false);});
  matchMedia('(min-width: 971px)').addEventListener('change',(event)=>{if(event.matches)setMenu(false);});
  document.getElementById('theme-toggle')?.addEventListener('click',()=>{const root=document.documentElement;const dark=root.dataset.theme==='dark'||(!root.dataset.theme&&matchMedia('(prefers-color-scheme: dark)').matches);root.dataset.theme=dark?'light':'dark';try{localStorage.setItem('tidewater-theme',root.dataset.theme)}catch{}});
</script>
</body></html>
