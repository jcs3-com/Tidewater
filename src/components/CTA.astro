---
const {title='Know what you can bid before you spend time on a bid.',body='Answer a few questions. See where you stand and what needs work.',href='/readiness',label='Take the readiness check'} = Astro.props;
---
<section class="section reverse closing-cta"><div class="container"><div class="section-head"><p class="eyebrow">A practical next step</p><h2>{title}</h2><p class="lead">{body}</p><a class="button" href={href}>{label} <span aria-hidden="true">↗</span></a></div></div></section>
