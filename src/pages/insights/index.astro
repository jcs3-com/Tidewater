---
import Base from '../../layouts/Base.astro';
import {articles} from '../../data/insights';
---
<Base title="Insights: Bids, Awards & Readiness | Tidewater" description="Operator-level guides to government bids, public award pricing and bid readiness.">
<section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Insights</p><h1>Useful notes from the bid desk.</h1><p class="lead">Three continuing series. No invented contracts, anonymous success stories or numbers without documents.</p></div><div class="grid-3">{articles.map(a=><article class="panel"><p class="eyebrow">{a.series}</p><h3><a href={`/insights/${a.slug}`}>{a.title}</a></h3><p>{a.description}</p><a class="link-arrow" href={`/insights/${a.slug}`}>Read article</a></article>)}</div></div></section>
<section class="section reverse"><div class="container"><h2>Know a solicitation we should cover?</h2><p class="lead">Send the public link. We'll review whether it fits the operators we serve.</p><a class="button" href="/contact">Send a link</a></div></section>
</Base>
