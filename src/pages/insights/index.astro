---
import Base from '../../layouts/Base.astro';
import {articles} from '../../data/insights';
---
<Base title="Insights: Bids, Awards & Readiness | Tidewater" description="Operator-level guides to government bids, public award pricing and bid readiness.">
<section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Insights</p><h1>Bid Desk articles</h1><p class="lead">Articles on government bidding, pricing and compliance.</p></div><div class="grid-3">{articles.map(a=><article class="panel"><p class="eyebrow">{a.series}</p><h3><a href={`/insights/${a.slug}`}>{a.title}</a></h3><p>{a.description}</p><a class="link-arrow" href={`/insights/${a.slug}`}>Read article</a></article>)}</div></div></section>
<section class="section reverse"><div class="container"><h2>Submit a solicitation</h2><p class="lead">Send the public link. We'll review whether it fits the operators we serve.</p><a class="button" href="/contact">Send a link</a></div></section>
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Getting started</p><h2>New to government work?</h2><p>Learn what to gather before your first bid and use the optional readiness check to identify gaps.</p><a class="link-arrow" href="/becoming-a-contractor">Becoming a government contractor</a></div><div class="panel"><p class="eyebrow">Ask the bid desk</p><h2>Have a solicitation in mind?</h2><p>Send the link and your service area. We will tell you whether it fits and what it would take.</p><a class="button" href="/contact">Contact Tidewater</a></div></div></section>
</Base>
