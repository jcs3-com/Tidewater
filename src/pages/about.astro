---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
---
<Base title="About Tidewater | Operator-Led Funding Advisory" description="Tidewater combines DMV funding intelligence and project advisory with hospitality operations experience. Learn our approach and independent standards.">
  <section class="section tw-page-hero"><div class="container tw-split"><div><p class="eyebrow">About Tidewater</p><h1>About Tidewater</h1></div><div><p class="lead">Tidewater Advisory researches public and private funding opportunities and supports grant applications and project implementation.</p><p>Our work is focused on hospitality-related businesses and organizations in DC, Maryland and Virginia.</p></div></div></section>
  <section class="section reverse"><div class="container tw-split"><div><p class="eyebrow">Founder / Operations experience</p><h2>Hospitality operations background</h2></div><div><p>James C. Simpson III spent more than 20 years in hospitality and related operations, including managing multi-location Washington restaurants, developing new concepts and founding Prepshift, a business serving restaurant and hospitality operators.</p><p>His experience includes restaurant operations, staffing, purchasing, business development and project implementation.</p><p>Tidewater has not published client grant results. Site examples describe potential projects, not completed engagements.</p></div></div></section>
  <section class="section"><div class="container tw-split"><div><p class="eyebrow">Our approach</p><h2>Funding opportunity at the source.</h2></div><div><p>We use official program notices to check eligibility, deadlines, matching requirements and applicant restrictions.</p><a class="button-quiet" href="/ethics">How we work ↗</a></div></div></section>
  <CTA title="Contact Tidewater" body="Send the project location, budget and timeline." href="/contact" label="Contact Tidewater"/>
</Base>
