---
import Base from '../layouts/Base.astro';
---
<Base title="How We Work | Tidewater Advisory" description="Tidewater's practical standards for source verification, client representation, independence and funding-advisory engagements.">
  <section class="section tw-page-hero"><div class="container"><p class="eyebrow">Tidewater / Our standards</p><h1>Operating standards</h1><p class="lead">We use published sources, document eligibility and obtain client approval before submission.</p></div></section>
  <section class="section reverse"><div class="container tw-four">
    <article class="panel"><h3>Official sources</h3><p>Link to funder notices and label open, closed or unverified programs.</p></article>
    <article class="panel"><h3>Eligibility</h3><p>Identify eligible applicants, sponsors, deadlines and matching costs.</p></article>
    <article class="panel"><h3>Client approval</h3><p>Clients approve application claims, financial information and submissions.</p></article>
    <article class="panel"><h3>No award guarantees</h3><p>Funders decide awards. Tidewater is independent and does not claim unearned results.</p></article>
  </div></section>
</Base>
