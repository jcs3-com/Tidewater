---
import Base from '../../../layouts/Base.astro';
import BidCard from '../../../components/BidCard.astro';
import {categories,jurisdictions} from '../../../lib/config';
import {getVisibleRfps,effectiveStatus} from '../../../lib/rfps';
export function getStaticPaths(){return categories.flatMap(c=>jurisdictions.map(j=>({params:{category:c.slug,jurisdiction:j.slug},props:{category:c,jurisdiction:j}})));}
const {category,jurisdiction}=Astro.props;
const relevant=(await getVisibleRfps()).filter(b=>b.category===category.slug&&b.jurisdiction===jurisdiction.slug);
const open=relevant.filter(b=>effectiveStatus(b)==='Open');
const awards=relevant.filter(b=>effectiveStatus(b)==='Awarded');
const faq=[{q:`Where can I find ${category.name.toLowerCase()} contracts in ${jurisdiction.name}?`,a:`Agencies publish solicitations on their procurement portals. Tidewater collects matching public opportunities when verified; use each official solicitation link as the source of truth.`},{q:'Do I need to be registered before I bid?',a:'Requirements vary by agency and solicitation. Check vendor registration, licenses, coverage and forms early; some deadlines cannot be extended.'}];
const schema=[{'@context':'https://schema.org','@type':'Service',name:`${category.name} government bid support in ${jurisdiction.name}`,serviceType:'Bid preparation',areaServed:{'@type':'AdministrativeArea',name:jurisdiction.name},provider:{'@type':'Organization',name:'Tidewater Advisory LLC'}},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))}];
---
<Base title={`${category.name} Government Contracts in ${jurisdiction.name} | Tidewater`} description={`Find verified ${category.name.toLowerCase()} solicitations and past awards in ${jurisdiction.name}. Learn requirements and prepare a bid with Tidewater.`} schema={schema}>
<section class="section"><div class="container"><p class="eyebrow">{jurisdiction.name} / {category.name}</p><div class="alt-hero"><h1>{category.name} contracts in {jurisdiction.name}.</h1><p class="lead">Public agencies buy services from outside operators. We help determine which solicitations fit your company, then organize the requirements, pricing inputs and response.</p><div class="actions"><a class="button" href="/readiness">Check your readiness</a><a class="button-quiet" href="/bids">How our bid desk works</a></div></div></div></section>
<section class="section narrow"><div class="container"><h2>Open {category.name.toLowerCase()} bids</h2>{open.length?<div class="bid-list">{open.map(b=><BidCard bid={b}/>)}</div>:<p>No verified open listings for this service and jurisdiction in our published board right now. Check the agency's official procurement portal for full coverage.</p>}</div></section>
<section class="section" style="background:var(--subtle)"><div class="container grid-2"><div><p class="eyebrow">What to expect</p><h2>Read the requirements before the price.</h2><p>{category.short} Every solicitation is different. Look for the service location, contract term, insurance limits, staff qualifications, required forms and how the agency wants prices presented.</p><p>A <strong>solicitation</strong> is the government's written invitation to compete. An <strong>addendum</strong> is an official change to that invitation. A <strong>bid tabulation</strong> is a published record of bids or prices, when available.</p></div><div class="panel"><h3>Your first-pass checklist</h3><ul><li>Are the work and locations inside your service area?</li><li>Can your team staff the hours and deliver the scope?</li><li>Can you meet the insurance, license and registration terms?</li><li>Is the deadline realistic?</li><li>Can you support the price with actual operating costs?</li></ul></div></div></section>
<section class="section narrow"><div class="container"><h2>Past public awards</h2>{awards.length?<div class="bid-list">{awards.map(b=><BidCard bid={b}/>)}</div>:<p>No verified award records have been published for this pairing. We do not estimate historic award prices without a public source.</p>}</div></section>
<section class="section narrow"><div class="container faq"><h2>Common questions</h2>{faq.map(x=><details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></section>
<section class="section reverse"><div class="container"><h2>We write for one firm per solicitation.</h2><p class="lead">Start with a readiness check or send the link to the official posting. We will tell you what it takes to put together a complete response.</p><a href="/readiness" class="button">Check your readiness</a></div></section>
</Base>
