---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Funding Services | Tidewater Advisory" description="Funding research, grants assistance, application support and project implementation for hospitality-adjacent organizations in DC, Maryland and Virginia.">
  <section class="section tw-page-hero"><div class="container tw-split"><div><p class="eyebrow">Tidewater / Funding Services</p><h1>Grant research, applications and project support</h1></div><div><p class="lead">Funding services for facility improvements, kitchens, refrigeration, food distribution, employee training and other eligible projects.</p><p>Serving restaurants, caterers, schools, nonprofits, food distributors and farms in DC, Maryland and Virginia.</p><div class="actions"><a class="button" href="/contact">Discuss a project ↗</a><a class="button-quiet" href="/funding-directory">Browse opportunities</a></div></div></div></section>

  <section class="section reverse"><div class="container"><p class="eyebrow">The engagement</p><h2>Our services</h2><div class="tw-four">
    <article class="panel"><span class="step-number">01 / Discover</span><h3>Funding research</h3><p>Identify relevant programs and document funding amounts, eligibility, deadlines, expenses and matching requirements.</p></article>
    <article class="panel"><span class="step-number">02 / Qualify</span><h3>Eligibility review</h3><p>Review applicant status, project budget, location, match and documentation requirements.</p></article>
    <article class="panel"><span class="step-number">03 / Prepare</span><h3>Grant applications</h3><p>Prepare budgets, narratives, supporting documents and submission checklists. Clients approve all applications.</p></article>
    <article class="panel" id="implementation"><span class="step-number">04 / Execute</span><h3>Grant management</h3><p>Track milestones, vendor deliverables, invoices and reporting obligations. Licensed work remains with qualified providers.</p></article>
  </div></div></section>

  <section class="section"><div class="container tw-split"><div><p class="eyebrow">What a project might involve</p><h2>Eligible project types</h2></div><div><p class="lead">Programs differ by applicant type, eligible expenses, award amount, match and reporting obligations.</p><ul class="tw-checklist"><li>Kitchen, refrigeration or cold-chain infrastructure</li><li>Restaurant expansion or eligible neighborhood improvements</li><li>Food preservation, donation and waste prevention</li><li>Hospitality workforce training and skills development</li><li>Food-system, farm and community-serving facilities</li></ul><p class="fine dim">Some programs require nonprofit status, an existing school-meals program, a local-government sponsor or matching funds. We do not present such funding as universally available.</p></div></div></section>

  <section class="section tw-resource-band"><div class="container tw-split"><div><p class="eyebrow">Transparent scope</p><h2>Engagement terms</h2></div><div><p>Services are quoted by project. We are independent of funders, do not guarantee awards and do not assume advisory fees qualify for grant reimbursement.</p><p>Legal, engineering, accounting and construction services must be performed by qualified professionals.</p><a href="/ethics" class="link-arrow">Read our operating principles ↗</a></div></div></section>
  <CTA title="Request a funding review" body="Provide the project location, estimated cost, schedule and organization type." href="/contact" label="Request a project discussion" />
</Base>
