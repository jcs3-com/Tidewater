---
import Base from '../layouts/Base.astro';
import DepthChart from '../components/DepthChart.astro';
import BidCard from '../components/BidCard.astro';
import CTA from '../components/CTA.astro';
import LeadForm from '../components/LeadForm.astro';
import {newsletterEnabled} from '../lib/config';
import {getOpenRfps,getBidBoardRfps} from '../lib/rfps';
const verified=await getOpenRfps();
const preview=verified.length?verified.slice(0,3):(await getBidBoardRfps()).filter(x=>x.status==='SAMPLE').slice(0,3);
const isDemo=!verified.length && !!preview.length;
---
<Base title="Tidewater | Government bid desk for DMV operators" description="The bid desk for DMV hospitality and service operators. Find contracts, understand pricing, prepare paperwork and produce a submission-ready response.">
<section class="hero"><div class="container hero-grid">
 <div class="hero-copy"><p class="eyebrow">Washington, DC · Maryland · Northern Virginia</p><h1 id="ab-heading" data-a="The bid desk for DMV hospitality and service operators." data-b="We find the contracts you're not seeing — and write the bid that wins.">The bid desk for DMV hospitality and service operators.</h1><p class="lead">You run the operation. We track the opportunities, read the bid documents, research past award prices and draft the response. You make the final call.</p><div class="actions"><a class="button" href="/readiness">Check your bid readiness</a><a class="button-quiet" href="/open-bids">See open bids</a></div><p class="fine dim">Independent advisory. No government affiliation. No award guarantee.</p></div>
 <div class="hero-chart"><DepthChart/><span class="chart-caption">Where the river meets the tide.<br/>38°53' N · 77°02' W</span></div>
</div></section>
<section class="section reverse"><div class="container"><div class="section-head"><p class="eyebrow">How it works</p><h2>Less hunting. Less guesswork. A better-prepared bid.</h2></div><div class="grid-3"><div class="panel"><span class="step-number">01 / We find it</span><h3>Find the right contract.</h3><p>We track public solicitations — the formal invitations agencies publish when they want vendors to compete — and screen them against your business.</p></div><div class="panel"><span class="step-number">02 / We price and write it</span><h3>Know what to submit.</h3><p>We review past bid tabulations (published bid prices), build your checklist and draft the response around your operation.</p></div><div class="panel"><span class="step-number">03 / You submit and win</span><h3>Put a credible bid forward.</h3><p>You review and approve the bid, then submit it on time. The agency decides who wins. No award is guaranteed.</p></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Two practices</p><h2>New contracts. Better operations.</h2></div><div class="grid-2"><div class="panel"><span class="small-kicker">01 / Government bids</span><h3>Bid desk</h3><p>For caterers, concession operators, janitorial firms, security teams and event service providers. From the opportunity screen through your final response.</p><a class="link-arrow" href="/bids">What the bid desk includes</a></div><div class="panel"><span class="small-kicker">02 / Restaurant operations</span><h3>Restaurant advisory</h3><p>Start with food waste. Audit what gets ordered, trimmed, discarded and donated. Improve yield and build recovery processes that staff can actually follow.</p><a class="link-arrow" href="/restaurant-advisory">Start with the waste audit</a></div></div></div></section>
<section class="section" style="background:var(--subtle)"><div class="container"><div class="section-head"><p class="eyebrow">Bid board</p><h2>{isDemo?'What the bid board will look like':'Newest open bids'}</h2><p>{isDemo?'The three entries below are fictional SAMPLE records for a working preview. No verified live bids are published yet.':verified.length?'These listings are refreshed from the RFP records during the daily site build. Always confirm details with the issuing agency.':'No verified open bids are listed right now. Check again after the next update.'}</p></div>{preview.length>0&&<div class="bid-list">{preview.map(b=><BidCard bid={b}/>)}</div>}<div class="actions"><a class="button-quiet" href="/open-bids">Open bid board</a></div></div></section>
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Bid readiness check</p><h2>Find the gaps before an agency does.</h2><p class="lead">Eleven practical questions about your business, coverage, capacity and registrations. Get a score and a punch list.</p><a href="/readiness" class="button">Take the free check</a></div><div class="panel"><p class="eyebrow">The bid digest</p><h3>Relevant bids. No clutter.</h3><p>Occasional notes on contract openings, public award pricing and requirements worth knowing.</p>{newsletterEnabled ? <><p>Confirm your subscription by email.</p><LeadForm kind="newsletter" heading="Subscribe to the bid digest" source="home-newsletter"/></> : <p class="fine">Signups open soon. In the meantime, <a href="/contact">send us a note</a>.</p>}</div></div></section>
<CTA title="You don't need a procurement department." body="You need to know which bids are worth your time, what they require and what a complete response looks like." href="/bids" label="See how the bid desk works"/>
<script is:inline>
  (function(){const h=document.querySelector('#ab-heading');if(!h)return;let variant;try{variant=sessionStorage.getItem('tidewater-headline');if(!['a','b'].includes(variant)){variant=Math.random()<.5?'a':'b';sessionStorage.setItem('tidewater-headline',variant)}}catch{variant='a'}h.textContent=h.getAttribute(`data-${variant}`);})();
</script>
</Base>
