---
import Base from '../layouts/Base.astro';
import BidCard from '../components/BidCard.astro';
import CTA from '../components/CTA.astro';
import {getOpenRfps,getBidBoardRfps} from '../lib/rfps';
const verified=await getOpenRfps();
const preview=verified.length?verified.slice(0,3):(await getBidBoardRfps()).filter(x=>x.status==='SAMPLE').slice(0,3);
const isDemo=!verified.length && !!preview.length;
---
<Base title="Tidewater | Government bid desk for DMV operators" description="The bid desk for DMV hospitality and service operators. Find contracts, understand pricing, prepare paperwork and produce a submission-ready response.">
<section class="hero-cinematic" aria-labelledby="home-heading">
 <div class="hero-landscape">
  <picture><source type="image/webp" srcset="/assets/chesapeake-marsh-960.webp 960w, /assets/chesapeake-marsh-1847.webp 1847w" sizes="100vw" /><img class="hero-image" src="/assets/chesapeake-marsh.jpg" width="1847" height="1114" alt="Tidal channels winding through marsh and woodland near Aberdeen, Maryland." fetchpriority="high" decoding="async" /></picture>
 </div>
 <div class="container hero-frame">
  <div class="hero-topline"><p>Washington, DC <span aria-hidden="true">/</span> Maryland <span aria-hidden="true">/</span> Northern Virginia</p><button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" hidden>Pause image motion</button></div>
  <div class="hero-shell">
   <div><p class="eyebrow">Your government bid desk</p><h1 id="home-heading">Government contracts.<br/><em>Within reach.</em></h1></div>
   <div class="hero-intro"><p class="lead">You run the business.<br/>We help prepare the bid.</p><p>We help hospitality and service operators find relevant government contracts, understand the requirements and prepare a response.</p><div class="actions"><a class="button" href="/contact">Contact Tidewater <span aria-hidden="true">&#8599;</span></a><a class="link-arrow" href="/open-bids">Browse opportunities <span aria-hidden="true">&#8599;</span></a></div></div>
   <p class="hero-disclosure">Independent advisory. No government affiliation. No award guarantee.</p>
  </div>
 </div>
</section>
<div class="oyster-band"><div class="container"><span class="landscape-credit">Chesapeake watershed · Photograph: Leo Miranda / USFWS</span></div></div>
<section class="section practices-section"><div class="container"><div class="practice practice-lead"><span class="small-kicker">Who we help</span><h3>Service businesses ready for their next contract.</h3><p>Caterers, concession operators, janitorial firms, security teams and event service providers. We help you assess whether an opportunity fits your services, capacity and schedule.</p></div><div class="editorial-heading flow-heading"><p class="eyebrow">The bid desk</p><h2><span class="nowrap">From Opportunity <span class="flow-arrow" aria-hidden="true">→</span><span class="sr-only">to</span></span> <span class="nowrap">Proposal <span class="flow-arrow" aria-hidden="true">→</span><span class="sr-only">to</span></span> <span class="nowrap">Award <span class="flow-arrow" aria-hidden="true">→</span><span class="sr-only">to</span></span> <span class="nowrap">Implementation.</span></h2></div><div class="practice practice-receive"><span class="small-kicker">What you receive</span><h3>The research, checklist, finalized proposal, and post-award implementation support.</h3><p>We review the solicitation and available past bid prices, organize the required documents and draft a response around your business. You review the details and approve the final bid. Post-award our team is ready to help implement your solution and bring a successful outcome.</p><a class="link-arrow" href="/bids">What the bid desk includes <span aria-hidden="true">&#8599;</span></a></div></div></section>
<section class="section reverse method-section"><div class="container"><div class="editorial-heading"><p class="eyebrow">The approach</p><h2>A clear process, from the first conversation.</h2><p class="lead">Start with your business or a solicitation you have in mind.</p></div><div class="grid-4"><div class="panel"><span class="step-number">01 / Opportunity</span><h3>Find the right fit.</h3><p>Share what your business does, where you work and any opportunity you are considering. We review the fit against your services, capacity and schedule before agreeing on scope and a flat fee.</p></div><div class="panel"><span class="step-number">02 / Proposal</span><h3>Build the response.</h3><p>We review the requirements and available public bid prices, build your checklist and draft the response with the information you provide. You check the details and approve the final price; submission support can be included in the agreed scope.</p></div><div class="panel"><span class="step-number">03 / Award</span><h3>Follow the decision.</h3><p>The agency evaluates the responses and decides the award. We help you track the decision, respond to clarification requests and read the published results, so every bid informs the next one.</p></div><div class="panel"><span class="step-number">04 / Implementation</span><h3>Start the contract well.</h3><p>After an award, we can help you launch: kickoff with the agency, staffing and onboarding, required paperwork and the reporting the contract calls for. Implementation support is scoped and quoted separately.</p></div></div></div></section>
<section class="section" style="background:var(--subtle)"><div class="container"><div class="section-head"><p class="eyebrow">Bid board</p><h2>{isDemo?'What the bid board will look like':'Newest open bids'}</h2><p>{isDemo?'The three entries below are fictional SAMPLE records for a working preview. No verified live bids are published yet.':verified.length?'A selection of current listings. Confirm requirements, deadlines and updates with the issuing agency.':'No verified open bids are listed right now. Check again after the next update.'}</p></div>{preview.length>0&&<div class="bid-list">{preview.map(b=><BidCard bid={b}/>)}</div>}<div class="actions"><a class="button-quiet" href="/open-bids">Browse all opportunities</a></div></div></section>
<CTA title="Let's talk about your next bid." body="Send us a solicitation link or tell us what your business does. We can discuss the opportunity, the work involved and the next step." href="/contact" label="Contact Tidewater"/>
<script src="/scripts/landscape.js" defer></script>
</Base>
