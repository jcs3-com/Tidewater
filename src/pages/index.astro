---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import {fundingProjects} from '../data/funding-projects';
---
<Base title="Tidewater Advisory | Hospitality Funding Services" description="Independent funding intelligence, grants assistance, and project implementation for hospitality-adjacent businesses and organizations across DC, Maryland and Virginia.">
  <section class="hero-cinematic tw-hero" aria-labelledby="home-heading">
    <div class="hero-landscape">
      <picture><source type="image/webp" srcset="/assets/chesapeake-marsh-960.webp 960w, /assets/chesapeake-marsh-1847.webp 1847w" sizes="100vw" /><img class="hero-image" src="/assets/chesapeake-marsh.jpg" width="1847" height="1114" alt="Tidal waterways across the Chesapeake landscape." fetchpriority="high" decoding="async" /></picture>
    </div>
    <div class="container hero-frame">
      <div class="hero-topline"><p>Washington, DC <span aria-hidden="true">/</span> Maryland <span aria-hidden="true">/</span> Virginia</p></div>
      <div class="hero-shell">
        <div><p class="eyebrow">Tidewater Advisory / DC · MD · VA</p><h1 id="home-heading">Funding opportunity at the source.</h1></div>
        <div class="hero-intro"><p class="lead">Grant research for hospitality and food businesses.</p><p>Tidewater researches grants, incentives and rebates; prepares applications; and supports funded projects in DC, Maryland and Virginia.</p></div>
        <p class="hero-disclosure">Independent of the funders and government programs we track. Funding is never guaranteed.</p>
      </div>
    </div>
  </section>
  <div class="oyster-band"><div class="container"><span class="landscape-credit">Chesapeake watershed · Photograph: Leo Miranda / USFWS</span></div></div>

  <section class="section tw-intro"><div class="container tw-split">
    <div><p class="eyebrow">Funding / DC · Maryland · Virginia</p><h2>Grants, incentives and project funding.</h2></div>
    <div><p class="lead">Programs may support facility expansion, kitchen equipment, cold storage, employee training and food-waste reduction. Each has different applicant and expense rules.</p><p>We review eligibility and deadlines, build application materials, and help manage the project when funding is awarded.</p><div class="actions"><a class="button" href="/funding-directory">Explore funding opportunities ↗</a><a class="button-quiet" href="/funding-services">How we help</a></div></div>
  </div></section>

  <section class="section reverse tw-services"><div class="container"><div class="tw-section-head"><p class="eyebrow">What we do</p><h2>Funding services</h2><p class="lead">Research, applications and implementation support.</p></div>
    <div class="grid-3">
      <article class="panel"><span class="step-number">01 / Research</span><h3>Grant and incentive research</h3><p>Find programs and document deadlines, eligibility, eligible costs and matching requirements.</p><a class="link-arrow" href="/funding-directory">Browse the Funding Finder ↗</a></article>
      <article class="panel"><span class="step-number">02 / Apply</span><h3>Application support</h3><p>Prepare budgets, application narratives and submission checklists. The client reviews and approves the final application.</p><a class="link-arrow" href="/funding-services">See funding services ↗</a></article>
      <article class="panel"><span class="step-number">03 / Manage</span><h3>Implementation</h3><p>Track vendor work, milestones, invoices and required reports for funded projects.</p><a class="link-arrow" href="/funding-services#implementation">Explore implementation ↗</a></article>
    </div>
  </div></section>

  <section class="section tw-projects"><div class="container"><div class="tw-section-head"><p class="eyebrow">Who this could serve</p><h2>Projects we can support</h2><p class="lead">Illustrative examples. These are not Tidewater client engagements or awards.</p></div>
    <div class="tw-project-grid">
      {fundingProjects.map(p=><article class="tw-project-card"><span class="step-number">{p.number} / {p.category}</span><p class="tw-audience">{p.audience}</p><h3>{p.title}</h3><p>{p.description}</p><p class="fine dim">{p.caveat}</p></article>)}
    </div>
    <div class="actions"><a class="button-quiet" href="/projects">See project examples ↗</a></div>
  </div></section>

  <section class="section tw-resource-band"><div class="container tw-split">
    <div><p class="eyebrow">Resources &amp; learning</p><h2>Resources</h2><p class="lead">Browse funding programs, project checklists and training plans.</p></div>
    <div class="tw-link-stack">
      <a href="/funding-directory"><strong>Funding Directory</strong><span>Publicly sourced programs, deadlines and eligibility notes ↗</span></a>
      <a href="/tools"><strong>Free Tools</strong><span>Planned calculators, trackers and checklists ↗</span></a>
      <a href="/academy"><strong>Tidewater Academy</strong><span>Future workshops, Fundamentals and Fellowship ↗</span></a>
    </div>
  </div></section>

  <section class="section tw-bid-feature"><div class="container tw-split"><div><p class="eyebrow">Also at Tidewater</p><h2>The Bid Desk.</h2></div><div><p class="lead">Bid Desk provides solicitation research and proposal preparation for government contracts.</p><a class="button-quiet" href="/bids">Explore Bid Desk ↗</a></div></div></section>
  <CTA title="Discuss a funding project" body="Send your project description, location and budget. We will review the scope and possible funding programs." href="/contact" label="Discuss your project" />
</Base>
