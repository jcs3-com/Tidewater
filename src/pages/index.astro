---
import Base from '../layouts/Base.astro';
import BidCard from '../components/BidCard.astro';
import CTA from '../components/CTA.astro';
import LeadForm from '../components/LeadForm.astro';
import {newsletterEnabled} from '../lib/config';
import {getOpenRfps,getBidBoardRfps} from '../lib/rfps';
const verified=await getOpenRfps();
const preview=verified.length?verified.slice(0,3):(await getBidBoardRfps()).filter(x=>x.status==='SAMPLE').slice(0,3);
const isDemo=!verified.length && !!preview.length;
---
<Base title="Tidewater | Government bid desk for DMV operators" description="The bid desk for DMV hospitality and service operators. Find contracts, understand pricing, prepare paperwork and produce a submission-ready response.">
<section class="hero-cinematic" aria-labelledby="home-heading">
 <div class="hero-landscape">
  <picture><source type="image/webp" srcset="/assets/chesapeake-marsh-960.webp 960w, /assets/chesapeake-marsh-1847.webp 1847w" sizes="100vw" /><img class="hero-image" src="/assets/chesapeake-marsh.jpg" width="1847" height="1114" alt="Tidal channels winding through marsh and woodland near Aberdeen, Maryland." fetchpriority="high" decoding="async" /></picture>
 </div>
 <div class="container hero-frame">
  <div class="hero-topline"><p>Washington, DC <span aria-hidden="true">/</span> Maryland <span aria-hidden="true">/</span> Northern Virginia</p><button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" hidden>Pause image motion</button></div>
  <div class="hero-shell">
   <div><p class="eyebrow">Independent bid desk &amp; operator-led advisory</p><h1 id="home-heading">Government contracts.<br/><em>Within reach.</em></h1></div>
   <div class="hero-intro"><p class="lead">You run the operation.<br/>We help you see the opportunity.</p><p>Relevant contracts. Clear requirements. A better-prepared response. A bid desk for DMV hospitality and service operators.</p><a class="button" href="/readiness">Assess your bid readiness <span aria-hidden="true">↗</span></a></div>
   <p class="hero-disclosure">Independent advisory. No government affiliation. No award guarantee.</p>
  </div>
 </div>
</section>
<div class="oyster-band"><div class="container"><span>Where the river meets the tide.</span><span class="landscape-credit">Chesapeake watershed · Photograph: Leo Miranda / USFWS</span></div></div>
<section class="section practices-section"><div class="container"><div class="editorial-heading"><p class="eyebrow">01 / Our practices</p><h2>New contracts.<br/>Better operations.</h2><p class="lead">Practical support for the people doing the work.</p></div><div class="grid-2"><div class="practice"><span class="small-kicker">Government bids</span><h3>A desk for your next opportunity.</h3><p>For caterers, concession operators, janitorial firms, security teams and event service providers. From the opportunity screen through your final response.</p><a class="link-arrow" href="/bids">Explore the bid desk <span aria-hidden="true">↗</span></a></div><div class="practice"><span class="small-kicker">Restaurant operations</span><h3>A closer look at your operation.</h3><p>Start with food waste. Audit what gets ordered, trimmed, discarded and donated. Improve yield and build recovery processes that staff can actually follow.</p><a class="link-arrow" href="/restaurant-advisory">Explore restaurant advisory <span aria-hidden="true">↗</span></a></div></div></div></section>
<section class="section reverse method-section"><div class="container"><div class="editorial-heading"><p class="eyebrow">02 / The approach</p><h2>Clarity at every step.</h2><p class="lead">Less hunting. Less guesswork.<br/>A better-prepared bid.</p></div><div class="grid-3"><div class="panel"><span class="step-number">01 / Find</span><h3>Find the right contract.</h3><p>We track public solicitations — the formal invitations agencies publish when they want vendors to compete — and screen them against your business.</p></div><div class="panel"><span class="step-number">02 / Prepare</span><h3>Know what to submit.</h3><p>We review past bid tabulations (published bid prices), build your checklist and draft the response around your operation.</p></div><div class="panel"><span class="step-number">03 / Review</span><h3>Put a credible bid forward.</h3><p>You review and approve the bid, then submit it on time. The agency decides who wins. No award is guaranteed.</p></div></div></div></section>
<section class="landscape-story"><div class="landscape-story-image"><picture><source type="image/webp" srcset="/assets/swan-island-640.webp 640w, /assets/swan-island-1200.webp 1200w" sizes="(max-width: 970px) 100vw, 50vw"/><img src="/assets/swan-island.jpg" width="1200" height="801" loading="lazy" decoding="async" alt="Marshland and tidal shallows around Swan Island in Maryland’s Chesapeake Bay."/></picture><p class="image-credit">Swan Island, Chesapeake Bay · Miles Simmons / USACE</p></div><div class="landscape-story-copy"><p class="eyebrow">A local perspective</p><h2>Grounded in<br/>the working region.</h2><p class="lead">Local knowledge. Practical operations. A willingness to read the fine print.</p><p>From Washington’s working waterfront to the tidal rivers and coast, Tidewater starts with the people who have to show up and deliver.</p><a class="link-arrow" href="/about">The Tidewater perspective <span aria-hidden="true">↗</span></a></div></section>
<section class="section" style="background:var(--subtle)"><div class="container"><div class="section-head"><p class="eyebrow">Bid board</p><h2>{isDemo?'What the bid board will look like':'Newest open bids'}</h2><p>{isDemo?'The three entries below are fictional SAMPLE records for a working preview. No verified live bids are published yet.':verified.length?'These listings are refreshed from the RFP records during the daily site build. Always confirm details with the issuing agency.':'No verified open bids are listed right now. Check again after the next update.'}</p></div>{preview.length>0&&<div class="bid-list">{preview.map(b=><BidCard bid={b}/>)}</div>}<div class="actions"><a class="button-quiet" href="/open-bids">Open bid board</a></div></div></section>
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Bid readiness check</p><h2>Find the gaps before an agency does.</h2><p class="lead">Eleven practical questions about your business, coverage, capacity and registrations. Get a score and a punch list.</p><a href="/readiness" class="button">Take the free check</a></div><div class="panel"><p class="eyebrow">The bid digest</p><h3>Relevant bids. No clutter.</h3><p>Occasional notes on contract openings, public award pricing and requirements worth knowing.</p>{newsletterEnabled ? <><p>Confirm your subscription by email.</p><LeadForm kind="newsletter" heading="Subscribe to the bid digest" source="home-newsletter"/></> : <p class="fine">Signups open soon. In the meantime, <a href="/contact">send us a note</a>.</p>}</div></div></section>
<CTA title="You don't need a procurement department." body="You need to know which bids are worth your time, what they require and what a complete response looks like." href="/bids" label="See how the bid desk works"/>
<script src="/scripts/landscape.js" defer></script>
</Base>
