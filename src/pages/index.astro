---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Tidewater Advisory | Read the current. Find the opportunity." description="Two practices for hospitality and service operators: government bid support through award and implementation, and restaurant advisory that finds funding and manages improvements through to results.">
<section class="hero-cinematic" aria-labelledby="home-heading">
 <div class="hero-landscape">
  <picture><source type="image/webp" srcset="/assets/chesapeake-marsh-960.webp 960w, /assets/chesapeake-marsh-1847.webp 1847w" sizes="100vw" /><img class="hero-image" src="/assets/chesapeake-marsh.jpg" width="1847" height="1114" alt="Tidal channels winding through marsh and woodland near Aberdeen, Maryland." fetchpriority="high" decoding="async" /></picture>
 </div>
 <div class="container hero-frame">
  <div class="hero-topline"><p>Washington, DC <span aria-hidden="true">/</span> Maryland <span aria-hidden="true">/</span> Virginia</p><button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" hidden>Pause image motion</button></div>
  <div class="hero-shell">
   <div><p class="eyebrow">Independent advisory / Government contracts + Restaurant operations</p><h1 id="home-heading">Read the current.<br/><em>Find the opportunity.</em></h1></div>
   <div class="hero-intro"><p class="lead">You run the business.<br/>We help you see what's possible.</p><p>Tidewater helps hospitality and service operators win government contracts and improve their operations: finding the opportunity, building the case and managing the work through to results.</p></div>
   <p class="hero-disclosure">Independent advisory. No government affiliation. No guarantee of contract awards or funding.</p>
  </div>
 </div>
</section>
<div class="oyster-band"><div class="container"><span class="landscape-credit">Chesapeake watershed · Photograph: Leo Miranda / USFWS</span></div></div>
<section class="division-image-section" aria-label="Our two advisory practices"><div class="container division-image-grid">
  <a class="division-image-card" href="/bids"><div class="division-image-frame"><picture><source type="image/webp" srcset="/assets/salt-marsh-channels-960.webp 960w, /assets/salt-marsh-channels-1600.webp 1600w" sizes="(max-width: 700px) 100vw, 50vw"/><img src="/assets/salt-marsh-channels.jpg" alt="Aerial view of tidal channels winding through salt marsh." width="1600" height="1200" loading="lazy" decoding="async" /></picture></div><div class="division-image-copy"><span class="eyebrow">01 / The Bid Desk</span><h2>Win the work.</h2><p>Opportunity discovery, pricing intelligence and submission-ready proposals for service operators.</p><span class="link-arrow">Explore the Bid Desk <span aria-hidden="true">&#8599;</span></span></div></a>
  <a class="division-image-card" href="/restaurant-advisory"><div class="division-image-frame"><picture><source type="image/webp" srcset="/assets/tidal-oysters-640.webp 640w" sizes="(max-width: 700px) 100vw, 50vw"/><img src="/assets/tidal-oysters.jpg" alt="Tidal water flowing around a cluster of oysters." width="640" height="480" loading="lazy" decoding="async" /></picture></div><div class="division-image-copy"><span class="eyebrow">02 / The Restaurant Advisory</span><h2>Make the operation better.</h2><p>Find funding, improve operating margins, reduce resource loss and manage the project through implementation.</p><span class="link-arrow">Explore the Restaurant Advisory <span aria-hidden="true">&#8599;</span></span></div></a>
</div></section>
<section class="section finder-band" aria-labelledby="finder-band-heading"><div class="container finder-band-grid">
  <div class="finder-band-mark" aria-hidden="true"><img src="/assets/brand/oyster-engraving-252.webp" srcset="/assets/brand/oyster-engraving-252.webp 252w, /assets/brand/oyster-engraving-503.webp 503w" sizes="(max-width: 700px) 160px, 252px" width="252" height="178" alt="" loading="lazy" decoding="async" /></div>
  <div><p class="eyebrow">Free Opportunity Finder</p><h2 id="finder-band-heading">See what fits before you spend a dollar.</h2><p class="lead">Answer a few questions about your business. We show a preliminary readiness read and the source-verified bids or restaurant funding programs we track that may fit.</p>
  <div class="actions"><a class="button" href="/opportunity-finder" data-track="finder_start" data-track-source="home">Start the Opportunity Finder <span aria-hidden="true">&#8599;</span></a><a class="button-quiet" href="/pricing">Bid Desk fees from $1,250, flat</a></div></div>
</div></section>
<CTA title="Start with a conversation." body="Send us a solicitation, a funding program you're weighing or a problem in your operation. We'll discuss the opportunity, the work involved and the next step." href="/contact" label="Contact Tidewater"/>
<script src="/scripts/landscape.js" defer></script>
</Base>
