---
import Base from '../layouts/Base.astro';
import {apiUrl,categories,jurisdictions} from '../lib/config';
const turnstileKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title="Bid Readiness Check | Tidewater" description="Free practical government bid readiness check for hospitality and service operators. Find the paperwork, insurance and registration gaps before you bid.">
<section class="section"><div class="container"><div class="section-head"><p class="eyebrow"><a href="/becoming-a-contractor">Becoming a contractor</a> / Bid readiness check</p><h1>Could your business bid this month?</h1><p class="lead">Eleven short questions. An illustrative score. A list of next actions. This is not an agency certification or a prediction of winning.</p></div>
<form id="readiness-form" action={`${apiUrl}/api/lead`} method="POST" class="form-body"><input type="hidden" name="kind" value="quiz" /><input type="hidden" name="source" value="readiness-check" /><input type="hidden" name="readinessScore" id="readiness-score" /><input type="hidden" name="gapList" id="gap-list" />
<div class="sr-only" aria-hidden="true"><label>Leave blank<input name="website" tabindex="-1" autocomplete="off" /></label></div>
<div class="form-section"><div class="field"><label for="entity">1. Is your business registered as a legal entity?</label><select name="entity" id="entity" required><option value="">Select</option><option value="registered">Yes</option><option value="no">Not yet / unsure</option></select></div></div>
<div class="form-section"><div class="field"><label for="years">2. How long have you operated?</label><select name="years" id="years" required><option value="">Select</option><option value="under1">Under a year</option><option value="1to2">1–2 years</option><option value="2plus">More than 2 years</option></select></div></div>
<div class="form-section"><div class="field"><label for="licenses">3. Do you hold the licenses your service normally needs?</label><select name="licenses" id="licenses" required><option value="">Select</option><option value="yes">Yes</option><option value="unsure">Unsure / not yet</option></select></div></div>
<div class="form-section"><div class="field"><label for="gl">4. Do you have general-liability insurance?</label><select name="gl" id="gl" required><option value="">Select</option><option value="yes">Yes</option><option value="no">No / unsure</option></select></div></div>
<div class="form-section"><div class="field"><label for="wc">5. Do you have workers' compensation coverage?</label><select name="wc" id="wc" required><option value="">Select</option><option value="yes">Yes</option><option value="not-applicable">We believe we are exempt</option><option value="no">No / unsure</option></select></div></div>
<div class="form-section"><div class="field"><label for="bond">6. Do you have bonding capacity if a bid requires it?</label><select name="bond" id="bond" required><option value="">Select</option><option value="yes">Yes</option><option value="no">No / unsure</option></select></div></div>
<div class="form-section"><div class="field"><label for="portals">7. Are you registered in government vendor portals?</label><select name="portals" id="portals" required><option value="">Select</option><option value="yes">Yes, at least one</option><option value="no">Not yet / unsure</option></select></div></div>
<div class="form-section"><div class="field"><label for="government">8. Have you done government work?</label><select name="government" id="government" required><option value="">Select</option><option value="yes">Yes</option><option value="no">No</option></select></div></div>
<div class="form-section"><div class="field"><label for="staff">9. How many staff can you assign to contracts?</label><select name="staff" id="staff" required><option value="">Select</option><option value="solo">Just me / undefined</option><option value="1to4">1–4</option><option value="5to9">5–9</option><option value="10plus">10+</option></select></div></div>
<div class="form-section"><div class="field"><label for="jurisdictions">10. Where can you perform the work?</label><select name="jurisdictions" id="jurisdictions" required><option value="">Select</option>{jurisdictions.map(j=><option value={j.slug}>{j.name}</option>)}</select><p class="fine">Pick your primary area. We can discuss others later.</p></div></div>
<div class="form-section"><div class="field"><label for="categories">11. What services could you bid?</label><select name="categories" id="categories" required><option value="">Select</option>{categories.map(c=><option value={c.slug}>{c.name}</option>)}</select></div></div>
<button type="button" id="calculate" class="button">Calculate my readiness</button>
<div class="quiz-results" id="results" hidden aria-live="polite"><p class="eyebrow">Your illustrative readiness score</p><p class="score" id="score-display">—</p><h2>Your next moves</h2><ul id="gap-display"></ul><p class="fine">This is a planning tool. Check the actual agency's requirements before bidding. A high score does not establish eligibility.</p></div>
<div id="followup" hidden><h2>Get matched to open bids.</h2><p>Send the result and your service area to Tidewater. We can review possible opportunities and follow up by email.</p><div class="form-grid"><div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="business">Business</label><input id="business" name="business" autocomplete="organization" required maxlength="160" /></div><div class="field"><label for="email">Email</label><input id="email" type="email" name="email" autocomplete="email" required maxlength="254" /></div><div class="field"><label for="phone">Phone (optional)</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div></div>
<div class="form-section"><label class="checkline"><input name="consent" type="checkbox" value="yes" required /><span>I agree to receive email follow-up from Tidewater about this readiness result and potential bid matches. I can opt out anytime. <a href="/privacy">Privacy policy</a>.</span></label></div>
{turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto"></div>}<button type="submit" class="button">Send my result and find matches</button><p class="form-feedback" aria-live="polite" role="status"></p></div>
</form></div></section>
{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script type="module" src="/scripts/readiness.js"></script>
</Base>
