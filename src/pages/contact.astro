---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
---
<Base title="Contact Tidewater | Discuss a Funding Project" description="Tell Tidewater about your project, funding opportunity or public bid. Independent support for hospitality-adjacent businesses and organizations across the DMV.">
  <section class="section"><div class="container grid-2"><div><p class="eyebrow">Contact / Start here</p><h1>Contact Tidewater</h1><p class="lead">Contact us about grants, incentives, food-system projects or government bid support.</p><p>Include the location, project budget, deadline and any relevant program link.</p><p><strong>Email:</strong> <a href="mailto:hello@tidewaterbid.com">hello@tidewaterbid.com</a></p><p class="fine">Independent advisory. Please don't submit passwords, banking records or sensitive employee information. We cannot promise funding or awards.</p></div><div class="panel"><h2>Project inquiry</h2><LeadForm kind="contact" compact={true} heading="Contact Tidewater" source="funding-contact" /></div></div></section>
</Base>
