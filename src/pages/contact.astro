import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
---
<Base title="Contact Tidewater | Government Bid Desk" description="Contact Tidewater about government bid preparation or an opportunity you are considering. Short form, direct reply.">
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Contact</p><h1>Let's talk about your next bid.</h1><p class="lead">Send a solicitation link or tell us what your business does and where you work. We can discuss whether the opportunity is a fit and how we can help.</p><p><strong>Email:</strong> <a href="mailto:hello@tidewaterbid.com">hello@tidewaterbid.com</a></p><p class="fine">We're an independent firm, not an agency. Please don't send passwords, payment details or sensitive employee information through this form.</p></div><div class="panel"><h2>Send a note.</h2><LeadForm kind="contact" heading="Contact Tidewater" source="contact-page" /></div></div></section>
</Base>
