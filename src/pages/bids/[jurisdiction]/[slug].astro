---
import Base from '../../../layouts/Base.astro';
import LeadForm from '../../../components/LeadForm.astro';
import {getVisibleRfps,effectiveStatus,bidUrl,type Rfp} from '../../../lib/rfps';
import {displayDate,displayValue,categoryName,jurisdictionName} from '../../../lib/config';
export async function getStaticPaths(){return (await getVisibleRfps()).map(b=>({params:{jurisdiction:b.jurisdiction,slug:b.slug},props:{bid:b}}));}
const {bid}=Astro.props as {bid:Rfp};
const status=effectiveStatus(bid);
const isSample=status==='SAMPLE';
const closed=['Closed','Awarded'].includes(status);
const schema= !isSample && bid.solicitationUrl ? [{'@context':'https://schema.org','@type':'WebPage',name:bid.title,description:bid.summary||`Solicitation issued by ${bid.agency}`,about:{'@type':'GovernmentService',name:bid.agency},relatedLink:bid.solicitationUrl}] : [];
---
<Base title={`${bid.title} | ${jurisdictionName(bid.jurisdiction)} | Tidewater`} description={`${isSample?'Fictional example only. ':'Bid details and preparation checklist. '}${bid.title}. Deadline: ${displayDate(bid.dueDate)}.`} canonical={bidUrl(bid)} ogImage={`/og/bids/${bid.jurisdiction}/${bid.slug}.png`} schema={schema} noindex={isSample}>
<section class="section"><div class="container"><a class="link-arrow" href="/open-bids">All bids</a><div class="alt-hero" style="margin-top:2rem"><p class="eyebrow">{categoryName(bid.category)} · {jurisdictionName(bid.jurisdiction)}</p><h1>{bid.title}</h1><p class="lead">{bid.summary||'The issuing agency sets the final requirements. Read the official documents before deciding to bid.'}</p></div>
{isSample&&<div class="notice"><strong>SAMPLE — not a real solicitation.</strong> This page exists to demonstrate the site template. Do not submit information in response to it.</div>}
<div class="facts"><div class="fact"><span class="mono">Due date</span><strong>{displayDate(bid.dueDate)}</strong><p class="fine" id="countdown" data-date={bid.dueDate} data-status={status}>{closed?'Closed':isSample?'Fictional example':'Calculating days remaining…'}</p></div><div class="fact"><span class="mono">Status</span><strong id="bid-status">{status}</strong></div><div class="fact"><span class="mono">Estimated value</span><strong>{displayValue(bid.estimatedValue)}</strong></div></div>
<div class="grid-2"><div><h2>What the agency is buying</h2><p>{bid.summary||'Details are in the official solicitation. We do not infer unstated scopes or requirements.'}</p><p class="fine">Agency: {bid.agency}</p>
{bid.solicitationUrl ? <a href={bid.solicitationUrl} target="_blank" rel="noopener noreferrer" class="button-quiet">Read official solicitation</a>:<p class="notice">[[TODO: Verified official solicitation URL]]</p>}</div>
<div class="panel"><h2>Requirements checklist</h2>{bid.requirements.length?<ul>{bid.requirements.map(x=><li>{x}</li>)}</ul>:<p>[[TODO: Requirements transcribed from the official solicitation]]</p>}<p class="fine">This is a screening aid, not a replacement for agency instructions. Check every form and addendum before submitting.</p></div></div>
{status==='Awarded'&&<div class="section narrow"><h2>Public award record</h2><p>Reported award: {displayValue(bid.awardAmount)}.</p>{bid.bidTabUrl?<a href={bid.bidTabUrl} rel="noopener noreferrer" target="_blank" class="button-quiet">Read public bid tabulation</a>:<p>The issuing agency has not provided a public bid tabulation in this record.</p>}</div>}
<section class="section narrow" id="bid-packet"><div class="callout"><p class="eyebrow">Bid packet request</p><h2>Get a working bid packet.</h2>{closed?<p><strong>Closed.</strong> The response deadline has passed. The public summary remains available for research.</p>:isSample?<p>This is a fictional example. Packet requests are disabled for sample listings.</p>:<><p>Request the checklist and document map for this solicitation. We'll confirm availability and next steps by email.</p><LeadForm kind="bid_packet" bidId={bid.id} source={`bid:${bid.jurisdiction}/${bid.slug}`} heading="Request the bid packet"/></>}</div></section>
</div></section>
<script is:inline>
(function(){const el=document.getElementById('countdown');const status=document.getElementById('bid-status');if(!el||!status||['SAMPLE','Closed','Awarded'].includes(el.dataset.status))return;const d=el.dataset.date;if(!/^\d{4}-\d{2}-\d{2}$/.test(d))return;const now=new Date();const t=Date.UTC(now.getFullYear(),now.getMonth(),now.getDate());const end=Date.parse(d+'T00:00:00Z');const days=Math.round((end-t)/86400000);if(days<0){el.textContent='Closed';status.textContent='Closed';document.getElementById('bid-packet')?.replaceChildren(Object.assign(document.createElement('p'),{textContent:'Closed. The response deadline has passed. Check the official agency record.'}));}else{el.textContent=`${days} calendar ${days===1?'day':'days'} until due date. Verify time with agency.`}})();
</script>
</Base>
