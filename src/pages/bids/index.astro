---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import BidCard from '../../components/BidCard.astro';
import {getBidBoardRfps,effectiveStatus} from '../../lib/rfps';
import {categories,jurisdictions} from '../../lib/config';
const board=await getBidBoardRfps();
const open=board.filter(b=>effectiveStatus(b)==='Open').length;
const samples=board.filter(b=>effectiveStatus(b)==='SAMPLE').length;
const faq=[
  {q:'Is government bidding only for big companies?',a:'No. Requirements differ by solicitation. The right starting point is a contract that fits your licenses, staffing, insurance and service area.'},
  {q:'What is a bid tabulation?',a:'A public record showing bids or prices submitted for a past solicitation, when the agency publishes it. It gives context, not a guaranteed winning price.'},
  {q:'Do you submit for us?',a:'Single Bid Architecture delivers the compliance checklist, price context and the structure of your response. Additional narrative drafting and agency submission support are quoted separately. You approve all prices and claims before anything is filed.'},
  {q:'What does it cost?',a:'A flat $1,250 for one solicitation under $100,000, or $2,500 for one at $100,000 and above. Complex or ongoing work is quoted separately and never below the applicable tier. The fee never depends on the award.'},
  {q:'Can you write for my competitor too?',a:'No. We write for one firm per solicitation. A match or inquiry alone does not reserve exclusivity; we confirm that commitment in writing.'}
];
const schema=[{'@context':'https://schema.org','@type':'Service',name:'Government bid desk',serviceType:'Public-sector bid preparation and opportunity screening',provider:{'@type':'Organization',name:'Tidewater Advisory LLC'},areaServed:['Washington, DC','Maryland','Northern Virginia'],offers:[{'@type':'Offer',name:'Single Bid Architecture',price:'1250',priceCurrency:'USD',description:'One solicitation with an estimated contract value under $100,000.'},{'@type':'Offer',name:'Single Bid Architecture — Tier II',price:'2500',priceCurrency:'USD',description:'One solicitation with an estimated contract value of $100,000 or more.'}]},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))}];
---
<Base title="Government Bid Desk | Tidewater" description="Find the right public contract. Review past bids, paperwork and deadlines. Single Bid Architecture from $1,250, flat, from an independent bid desk." schema={schema}>
<section class="section"><div class="container alt-hero"><p class="eyebrow">Tidewater Advisory / 01 The Bid Desk</p><h1>Government contracts aren't just for national firms.</h1><p class="lead">Your business may already provide what agencies buy. The challenge is seeing the opportunity, understanding the rules and finding time to write the response.</p><div class="actions"><a class="button" href="/opportunity-finder?path=bids" data-track="finder_start" data-track-source="bids-hero">Find opportunities, free</a><a class="button-quiet" href="#open-opportunities">See open bids</a><a class="link-arrow" href="/pricing">Flat fees from $1,250 <span aria-hidden="true">&#8599;</span></a></div></div></section>
<section class="section bid-process" aria-labelledby="bid-process-heading"><div class="container"><div class="editorial-heading flow-heading"><p class="eyebrow">Our RFP process</p><h2 id="bid-process-heading"><span class="nowrap">From Opportunity <span class="flow-arrow" aria-hidden="true">→</span><span class="sr-only">to</span></span> <span class="nowrap">Proposal <span class="flow-arrow" aria-hidden="true">→</span><span class="sr-only">to</span></span> <span class="nowrap">Award <span class="flow-arrow" aria-hidden="true">→</span><span class="sr-only">to</span></span> <span class="nowrap">Implementation.</span></h2></div><p class="lead process-lead">A clear process, from the first conversation. Start with your business or a solicitation you have in mind.</p><div class="grid-4"><div class="panel"><span class="step-number">01 / Opportunity</span><h3>Find the right fit.</h3><p>Share what your business does, where you work and any opportunity you are considering. We review the fit against your services, capacity and schedule before agreeing on scope and a flat fee.</p></div><div class="panel"><span class="step-number">02 / Proposal</span><h3>Build the response.</h3><p>We review the requirements and available public bid prices, build your compliance checklist and the architecture of your response from the information you provide. You check the details and approve the final price. Additional drafting and submission support are quoted separately.</p></div><div class="panel"><span class="step-number">03 / Award</span><h3>Follow the decision.</h3><p>The agency evaluates the responses and decides the award. We help you track the decision, respond to clarification requests and read the published results, so every bid informs the next one.</p></div><div class="panel"><span class="step-number">04 / Implementation</span><h3>Start the contract well.</h3><p>After an award, we can help you launch: kickoff with the agency, staffing and onboarding, required paperwork and the reporting the contract calls for. Implementation support is scoped and quoted separately.</p></div></div></div></section>
<section class="section" id="open-opportunities" style="background:var(--subtle)"><div class="container"><div class="section-head"><p class="eyebrow">Open opportunities</p><h2>Current open bids</h2><p>Filter by work, geography and deadline. Every listing links to the issuing agency's official posting; confirm requirements, deadlines and addenda there.</p><p class="fine">{open} verified open {open===1?'listing':'listings'} at last build.</p></div>
{samples>0 && <div class="notice"><strong>Demo mode:</strong> SAMPLE cards are fictional. They are for layout and workflow testing, not real contracting opportunities.</div>}
{board.length>0 && <><div class="filter-bar" id="filters"><div class="field"><label for="category-filter">Category</label><select id="category-filter"><option value="all">All categories</option>{categories.map(c=><option value={c.slug}>{c.name}</option>)}</select></div><div class="field"><label for="jurisdiction-filter">Jurisdiction</label><select id="jurisdiction-filter"><option value="all">All jurisdictions</option>{jurisdictions.map(j=><option value={j.slug}>{j.name}</option>)}</select></div><div class="field"><label for="due-filter">Due window</label><select id="due-filter"><option value="all">Any date</option><option value="7">Next 7 days</option><option value="30">Next 30 days</option><option value="60">Next 60 days</option></select></div></div>
<p id="filter-count" class="eyebrow" aria-live="polite">{board.length} listings</p>
<div class="bid-list" id="bid-results">{board.map(b=><BidCard bid={b}/>)}</div>
<p id="no-results" class="notice" hidden>No bids match these filters. Try a wider window or another jurisdiction.</p></>}
{board.length===0&&<div class="panel"><h2>No verified open bids right now.</h2><p>New solicitations appear here as agencies post them and we verify the official notice.</p><a class="button" href="/opportunity-finder">Get matched when one fits</a></div>}
</div></section>
<script src="/scripts/bid-filters.js" defer></script>
<section class="section reverse"><div class="container"><p class="eyebrow">Who it's for</p><h2>Operators with a real service to sell.</h2><div class="grid-3"><div class="panel"><h3>Food and hospitality</h3><p>Event caterers, concessions, beverage service and venue operators.</p></div><div class="panel"><h3>Building services</h3><p>Janitorial teams and facility support businesses with defined staffing and coverage.</p></div><div class="panel"><h3>Event operations</h3><p>Security, setup crews, event staffing and specialty vendors.</p></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Your bid desk</p><h2>What is included</h2></div><div class="grid-2"><div class="panel"><h3>Opportunity match</h3><p>A practical go/no-go screen for the contract, geography, staffing, licensing and deadline.</p></div><div class="panel"><h3>Price-to-win context</h3><p>We examine available bid tabulations: public records of the prices bidders offered in prior procurements. History informs the decision. It cannot predict an award.</p></div><div class="panel"><h3>Compliance checklist</h3><p>A line-by-line list of required registrations, insurance, forms, addenda (updates to the solicitation), certifications and signatures.</p></div><div class="panel"><h3>Response architecture</h3><p>The structure of your response, organized to match the agency's instructions. Additional narrative drafting and submission support are available as a separate quote.</p></div></div><p class="notice"><strong>Single Bid Architecture: $1,250</strong> for one solicitation under $100,000, or <strong>$2,500</strong> at $100,000 and above. Flat, agreed in writing, never contingent on the award. <a href="/pricing">Pricing details</a>.</p><p class="notice"><strong>One firm, one solicitation.</strong> We write for one firm per solicitation. Any exclusivity reservation is confirmed in writing.</p></div></section>
<section class="section" style="background:var(--subtle)"><div class="container grid-2"><div><p class="eyebrow">Your part</p><h2>What we need from you.</h2><p>We do the desk work. You supply the things only your company can verify.</p></div><div><ul><li>Insurance certificates and actual coverage limits.</li><li>Licenses, business registrations and vendor-portal logins or registration status.</li><li>References and examples of comparable jobs you really performed.</li><li>Staffing capacity, service area and operating constraints.</li><li>Your cost and margin inputs. You approve the final price.</li></ul><p class="fine">We will not fabricate experience or certify compliance on your behalf.</p></div></div></section>
<section class="section"><div class="container faq"><p class="eyebrow">Quick answers</p><h2>Before you start</h2>{faq.map(x=><details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></section>
<section class="section"><div class="container"><p class="eyebrow">New to government work?</p><h2>Start with the basics.</h2><p>Find out what to gather before your first bid, with an optional readiness check to help identify gaps.</p><a class="link-arrow" href="/becoming-a-contractor">Becoming a government contractor <span aria-hidden="true">&#8599;</span></a></div></section>
<CTA/>
</Base>
