---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
const faq=[
  {q:'Is government bidding only for big companies?',a:'No. Requirements differ by solicitation. The right starting point is a contract that fits your licenses, staffing, insurance and service area.'},
  {q:'What is a bid tabulation?',a:'A public record showing bids or prices submitted for a past solicitation, when the agency publishes it. It gives context, not a guaranteed winning price.'},
  {q:'Do you submit for us?',a:'We provide a near-complete draft and a submission checklist. Submission assistance is optional. You approve all prices and claims before anything is filed.'},
  {q:'Can you write for my competitor too?',a:'No. We write for one firm per solicitation. A match or inquiry alone does not reserve exclusivity; we confirm that commitment in writing.'}
];
const schema=[{'@context':'https://schema.org','@type':'Service',name:'Government bid desk',serviceType:'Public-sector bid preparation and opportunity screening',provider:{'@type':'Organization',name:'Tidewater Advisory LLC'},areaServed:['Washington, DC','Maryland','Northern Virginia']},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))}];
---
<Base title="Government Bid Desk | Tidewater" description="Find the right public contract. Review past bids, paperwork and deadlines. Get a drafted response from an independent bid desk." schema={schema}>
<section class="section"><div class="container alt-hero"><p class="eyebrow">Government bid desk</p><h1>Government contracts aren't just for national firms.</h1><p class="lead">Your business may already provide what agencies buy. The challenge is seeing the opportunity, understanding the rules and finding time to write the response.</p><div class="actions"><a class="button" href="/readiness">Check your readiness</a><a class="button-quiet" href="/pricing">See flat fees</a></div></div></section>
<section class="section reverse"><div class="container"><p class="eyebrow">Who it's for</p><h2>Operators with a real service to sell.</h2><div class="grid-3"><div class="panel"><h3>Food and hospitality</h3><p>Event caterers, concessions, beverage service and venue operators.</p></div><div class="panel"><h3>Building services</h3><p>Janitorial teams and facility support businesses with defined staffing and coverage.</p></div><div class="panel"><h3>Event operations</h3><p>Security, setup crews, event staffing and specialty vendors.</p></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Your bid desk</p><h2>What is included</h2></div><div class="grid-2"><div class="panel"><h3>Opportunity match</h3><p>A practical go/no-go screen for the contract, geography, staffing, licensing and deadline.</p></div><div class="panel"><h3>Price-to-win context</h3><p>We examine available bid tabulations: public records of the prices bidders offered in prior procurements. History informs the decision. It cannot predict an award.</p></div><div class="panel"><h3>Compliance checklist</h3><p>A line-by-line list of required registrations, insurance, forms, addenda (updates to the solicitation), certifications and signatures.</p></div><div class="panel"><h3>Drafted response</h3><p>A near-complete proposal, organized to match the agency's instructions. We can also support the final submission if agreed.</p></div></div><p class="notice"><strong>One firm, one solicitation.</strong> We write for one firm per solicitation. Any exclusivity reservation is confirmed in writing.</p></div></section>
<section class="section" style="background:var(--subtle)"><div class="container grid-2"><div><p class="eyebrow">Your part</p><h2>What we need from you.</h2><p>We do the desk work. You supply the things only your company can verify.</p></div><div><ul><li>Insurance certificates and actual coverage limits.</li><li>Licenses, business registrations and vendor-portal logins or registration status.</li><li>References and examples of comparable jobs you really performed.</li><li>Staffing capacity, service area and operating constraints.</li><li>Your cost and margin inputs. You approve the final price.</li></ul><p class="fine">We will not fabricate experience or certify compliance on your behalf.</p></div></div></section>
<section class="section"><div class="container faq"><p class="eyebrow">Quick answers</p><h2>Before you start</h2>{faq.map(x=><details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></section>
<CTA/>
</Base>
