---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Resources & Funding Intelligence | Tidewater" description="DMV grants and incentives, planned free templates and calculators, learning resources and practical guidance for hospitality-adjacent operators.">
  <section class="section tw-page-hero"><div class="container"><p class="eyebrow">Tidewater / Resource Library</p><h1>Funding resources</h1><p class="lead">Funding program listings, planned grant templates and procurement guides for organizations in DC, Maryland and Virginia.</p></div></section>
  <section class="section reverse"><div class="container tw-resource-grid">
    <article class="panel"><p class="eyebrow">Live / Funding intelligence</p><h2>Funding Directory</h2><p>Search source-linked grants, rebates and incentives by state, type and status.</p><a class="button" href="/funding-directory">Browse the directory ↗</a></article>
    <article class="panel"><p class="eyebrow">Planned / Free tools</p><h2>Tools &amp; Templates</h2><p>Five planned tools: funding fit, grant readiness, project budget, application tracking and food waste.</p><a class="button-quiet" href="/tools">View planned tools ↗</a></article>
    <article class="panel"><p class="eyebrow">Learning / In development</p><h2>Tidewater Academy</h2><p>Fundamentals and Fellowship are planned. No courses or applications are open.</p><a class="button-quiet" href="/academy">Explore Academy ↗</a></article>
    <article class="panel"><p class="eyebrow">Existing / Bid Desk articles</p><h2>Operator Insights</h2><p>Articles covering government bids, award pricing and contractor readiness.</p><a class="button-quiet" href="/insights">Read insights ↗</a></article>
  </div></section>
  <CTA title="Contact us about a funding program" body="Send the source link or a short project description." href="/contact" label="Discuss a funding question"/>
</Base>
