    {['Funding sources and eligibility','Scoping a fundable project','Budgets, narratives and submission','Award conditions and reporting'].map((title,i)=><article class="panel"><span class="step-number">0{i+1} / Module concept</span><h3>{title}</h3></article>)}
  </div></section>
</Base>
