# Public site settings (required before launch)
SITE_URL=https://tidewaterbid.com
# Leave blank for same-origin Cloudflare Pages Functions; local Astro dev can use port 8787.
PUBLIC_API_URL=
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_TURNSTILE_SITE_KEY=
# Build-time ONLY (never use PUBLIC_ prefix)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=app5wO7MKQ92y16f1
DEMO_SEED=1
# Launch gates (build-time). Leave 0 until LAUNCH_CHECKLIST items are cleared.
SITE_INDEXABLE=0
NEWSLETTER_ENABLED=0
# Worker-only secrets: use wrangler secret put, not this file
# AIRTABLE_PAT, AIRTABLE_BASE_ID, RESEND_API_KEY, FROM_EMAIL, HMAC_SECRET
# MAILING_ADDRESS, SITE_URL, ALLOWED_ORIGIN, TURNSTILE_SECRET (optional)
